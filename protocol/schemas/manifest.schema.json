{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanbackup.local/schemas/manifest.schema.json",
  "title": "备份清单（PeerManifest）",
  "description": "对端接收目录清单（GET /api/backup/v1/manifest 响应）。files 为 relPath → {size, mtime} 映射。",
  "type": "object",
  "required": ["generatedAt", "deviceCode", "files", "version"],
  "properties": {
    "generatedAt": { "type": "integer", "minimum": 0 },
    "deviceCode": { "type": "string" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["size"],
        "properties": {
          "size": { "type": "integer", "minimum": 0 },
          "mtime": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "version": { "type": "integer" },
    "available": { "type": "boolean" }
  },
  "additionalProperties": true
}
