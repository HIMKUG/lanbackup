{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanbackup.local/schemas/prepare-upload.request.schema.json",
  "title": "Prepare-upload 请求",
  "description": "POST /api/localsend/v2/prepare-upload 请求体。files 为 fileId → FileDto 映射。",
  "type": "object",
  "required": ["info", "files"],
  "properties": {
    "info": {
      "type": "object",
      "required": ["alias", "version", "fingerprint", "port", "protocol"],
      "properties": {
        "alias": { "type": "string" },
        "version": { "type": "string" },
        "deviceModel": { "type": "string" },
        "deviceType": { "type": "string" },
        "fingerprint": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["http", "https"] },
        "download": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/FileDto" }
    },
    "ecdhPubKey": { "type": "string" }
  },
  "$defs": {
    "FileDto": {
      "type": "object",
      "required": ["id", "fileName", "size", "fileType"],
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "fileType": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "preview": { "type": ["string", "null"] },
        "metadata": {
          "type": "object",
          "properties": {
            "modified": { "type": ["string", "null"] },
            "accessed": { "type": ["string", "null"] }
          }
        },
        "protocolExtensions": { "type": "array", "items": { "type": "string" } },
        "merkleRoot": { "type": ["string", "null"] },
        "pieceHashes": { "type": ["array", "null"], "items": { "type": "string" } },
        "chunkSize": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
