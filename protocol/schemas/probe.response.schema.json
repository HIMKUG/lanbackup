{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsend-v3/schemas/probe.response.schema.json",
  "title": "GET /api/v3/probe 响应",
  "description": "发现阶段端点，无需认证。返回设备基本信息 + 静态公钥 + serverNonce（发起首次配对所需的全部材料，方案.txt §3.1）。",
  "type": "object",
  "required": ["deviceId", "alias", "deviceType", "port", "protocolVersion", "staticPub", "publicKey", "serverNonce"],
  "properties": {
    "deviceId": { "type": "string", "format": "uuid" },
    "alias": { "type": "string", "minLength": 1 },
    "deviceType": { "type": "string", "enum": ["desktop", "mobile"] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocolVersion": { "type": "string", "enum": ["3.0", "3.1"], "description": "3.1 = 新增 ECDSA 签名信任锚字段" },
    "staticPub": { "type": "string", "pattern": "^[A-Za-z0-9_-]{80,}$", "description": "P-256 静态公钥，SEC1 未压缩（0x04+64B）base64url" },
    "publicKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{80,}$", "description": "v5：本机 ECDSA P-256 签名公钥，SEC1 未压缩 base64url（配对信任锚）" },
    "serverNonce": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "32B 随机 hex，参与 pairing_secret 派生与 HMAC" },
    "capabilities": {
      "type": "object",
      "required": ["maxChunkSize", "supportedEncryption", "supportsResume"],
      "properties": {
        "maxChunkSize": { "type": "integer", "minimum": 1 },
        "supportedEncryption": { "type": "array", "items": { "type": "string", "enum": ["aes-256-gcm"] }, "minItems": 1 },
        "supportsResume": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
