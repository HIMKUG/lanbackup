{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanbackup.local/schemas/chunk-status.response.schema.json",
  "title": "Chunk-status 响应",
  "description": "GET /api/backup/v1/chunk-status?encodedPath=... 响应。receivedChunks 为已收分片索引，nextChunk 为下一缺失索引。",
  "type": "object",
  "required": ["receivedChunks", "nextChunk", "fileComplete"],
  "properties": {
    "receivedChunks": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "nextChunk": { "type": "integer", "minimum": 0 },
    "fileComplete": { "type": "boolean" }
  },
  "additionalProperties": true
}
