{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lanbackup/schemas/v4/session.tasks.schema.json",
  "title": "V4 session.tasks",
  "description": "`GET /api/v4/session/tasks` 的响应",
  "type": "object",
  "required": [
    "phase",
    "sessionId",
    "tasks"
  ],
  "properties": {
    "phase": {
      "$ref": "#/definitions/TransferPhase"
    },
    "sessionId": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskReceipt"
      }
    }
  },
  "definitions": {
    "TaskReceipt": {
      "type": "object",
      "required": [
        "fileId",
        "relPath",
        "status"
      ],
      "properties": {
        "fileId": {
          "type": "string"
        },
        "finalName": {
          "description": "因冲突重命名后的最终文件名",
          "type": [
            "string",
            "null"
          ]
        },
        "mtime": {
          "description": "接收端保留的 mtime（必须等于发送端的 mtime）",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "reason": {
          "description": "失败原因",
          "type": [
            "string",
            "null"
          ]
        },
        "relPath": {
          "type": "string"
        },
        "size": {
          "description": "接收端实际落盘的大小",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "status": {
          "$ref": "#/definitions/TaskStatus"
        }
      }
    },
    "TaskStatus": {
      "description": "单个文件的任务终态。\n\n**终态由接收端判定** —— 数据在谁的磁盘上谁知道。 发送端心跳超时时**不允许自行判定失败**，必须先查询对端终态 （这正是\"一方认为在传输可重试、另一方认为已完成\"的直接原因）。",
      "type": "string",
      "enum": [
        "queued",
        "transferring",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "TransferPhase": {
      "description": "传输会话阶段。\n\n**这是双方共识，不是本地字段** —— 阶段变更需对端 ack （`V4-TRANSFER-MODULE.md` §2.3）。",
      "oneOf": [
        {
          "description": "无会话",
          "type": "string",
          "enum": [
            "idle"
          ]
        },
        {
          "description": "建立会话、能力协商、选择算法",
          "type": "string",
          "enum": [
            "preparing"
          ]
        },
        {
          "description": "拉取对端权威块位图（仅主算法）",
          "type": "string",
          "enum": [
            "reconciling"
          ]
        },
        {
          "description": "传块中",
          "type": "string",
          "enum": [
            "transferring"
          ]
        },
        {
          "description": "心跳超时/网络中断，等待重试或对账",
          "type": "string",
          "enum": [
            "paused"
          ]
        },
        {
          "description": "正在从主算法切换到基础算法",
          "type": "string",
          "enum": [
            "degrading"
          ]
        },
        {
          "description": "整体校验",
          "type": "string",
          "enum": [
            "verifying"
          ]
        },
        {
          "description": "已完成（终态）",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "失败（终态）",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "已中止（终态）",
          "type": "string",
          "enum": [
            "aborted"
          ]
        }
      ]
    }
  }
}
