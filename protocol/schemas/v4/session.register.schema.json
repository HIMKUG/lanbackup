{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lanbackup/schemas/v4/session.register.schema.json",
  "title": "V4 session.register",
  "type": "object",
  "required": [
    "alias",
    "deviceId",
    "sessionId"
  ],
  "properties": {
    "alias": {
      "type": "string"
    },
    "deviceId": {
      "type": "string"
    },
    "sessionId": {
      "description": "会话 ID，必须用 CSPRNG 生成。\n\n原 `Date.now() + Math.random()` 生成方式可预测， 同网段攻击者能猜测并劫持/污染会话（原 `scheduler.ts:391-397`）。",
      "type": "string"
    }
  }
}
