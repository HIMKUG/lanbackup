{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lanbackup/schemas/v4/session.phase.schema.json",
  "title": "V4 session.phase",
  "type": "object",
  "required": [
    "algorithm",
    "bitmapVersion",
    "phase",
    "sessionId"
  ],
  "properties": {
    "algorithm": {
      "$ref": "#/definitions/Algorithm"
    },
    "bitmapVersion": {
      "description": "本端已确认的块位图版本号，供对端判断是否需要重新对账",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "degrade_reason": {
      "description": "降级原因；未降级时为空",
      "anyOf": [
        {
          "$ref": "#/definitions/DegradeReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "$ref": "#/definitions/TransferPhase"
    },
    "sessionId": {
      "type": "string"
    }
  },
  "definitions": {
    "Algorithm": {
      "description": "当前生效的算法",
      "oneOf": [
        {
          "description": "主算法：块级差异 + Merkle + 断点续传 + 并发",
          "type": "string",
          "enum": [
            "advanced"
          ]
        },
        {
          "description": "基础算法：16MB 分块顺序传输 + 简单续传",
          "type": "string",
          "enum": [
            "basic"
          ]
        }
      ]
    },
    "DegradeReason": {
      "description": "降级原因码。UI 必须显示\"当前算法 + 降级原因 + 已传进度处置\"。",
      "oneOf": [
        {
          "description": "对端不具备主算法能力。稳定原因，**不**记入设备级降级记忆 （对端升级后自然恢复）。",
          "type": "string",
          "enum": [
            "PEER_NO_CAPABILITY"
          ]
        },
        {
          "description": "主算法初始化失败（Merkle 构建 / 密钥派生 / 端点异常）",
          "type": "string",
          "enum": [
            "INIT_FAILED"
          ]
        },
        {
          "description": "对账连续失败",
          "type": "string",
          "enum": [
            "RECONCILE_FAILED"
          ]
        },
        {
          "description": "心跳超时后对账重试耗尽",
          "type": "string",
          "enum": [
            "RETRY_EXHAUSTED"
          ]
        },
        {
          "description": "连续块失败达到阈值",
          "type": "string",
          "enum": [
            "CHUNK_RETRY_EXHAUSTED"
          ]
        },
        {
          "description": "整体校验反复失败",
          "type": "string",
          "enum": [
            "VERIFY_FAILED"
          ]
        }
      ]
    },
    "TransferPhase": {
      "description": "传输会话阶段。\n\n**这是双方共识，不是本地字段** —— 阶段变更需对端 ack （`V4-TRANSFER-MODULE.md` §2.3）。",
      "oneOf": [
        {
          "description": "无会话",
          "type": "string",
          "enum": [
            "idle"
          ]
        },
        {
          "description": "建立会话、能力协商、选择算法",
          "type": "string",
          "enum": [
            "preparing"
          ]
        },
        {
          "description": "拉取对端权威块位图（仅主算法）",
          "type": "string",
          "enum": [
            "reconciling"
          ]
        },
        {
          "description": "传块中",
          "type": "string",
          "enum": [
            "transferring"
          ]
        },
        {
          "description": "心跳超时/网络中断，等待重试或对账",
          "type": "string",
          "enum": [
            "paused"
          ]
        },
        {
          "description": "正在从主算法切换到基础算法",
          "type": "string",
          "enum": [
            "degrading"
          ]
        },
        {
          "description": "整体校验",
          "type": "string",
          "enum": [
            "verifying"
          ]
        },
        {
          "description": "已完成（终态）",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "失败（终态）",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "已中止（终态）",
          "type": "string",
          "enum": [
            "aborted"
          ]
        }
      ]
    }
  }
}
