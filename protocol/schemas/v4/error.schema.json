{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lanbackup/schemas/v4/error.schema.json",
  "title": "V4 error",
  "description": "线上传输的错误信封。\n\n**注意**：`message` 只放可对外披露的信息。内部诊断细节走日志， 不回传给对端 —— 避免给攻击者提供 oracle（原 `crypto.ts` verifyChallengeResponse 就是\"先比长度再逐字节、整体 try/catch 返回 false\"而不抛具体原因）。",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "$ref": "#/definitions/ErrorBody"
    }
  },
  "definitions": {
    "ErrorBody": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ErrorCode": {
      "description": "错误码。取值沿用协议契约已有的错误码集合。",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "INVALID_CODE",
            "HMAC_MISMATCH",
            "UNTRUSTED",
            "RATE_LIMIT_EXCEEDED",
            "NOT_FOUND",
            "VERSION_UNSUPPORTED",
            "UNKNOWN_DEVICE",
            "TOKEN_EXPIRED"
          ]
        },
        {
          "description": "对端不具备请求的能力",
          "type": "string",
          "enum": [
            "CAPABILITY_UNSUPPORTED"
          ]
        },
        {
          "description": "传输已中止（用户中止或连接断开）",
          "type": "string",
          "enum": [
            "ABORTED"
          ]
        },
        {
          "description": "会话无进展超时",
          "type": "string",
          "enum": [
            "STALLED"
          ]
        },
        {
          "description": "内部错误",
          "type": "string",
          "enum": [
            "INTERNAL"
          ]
        }
      ]
    }
  }
}
