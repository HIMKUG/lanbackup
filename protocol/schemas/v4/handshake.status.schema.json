{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lanbackup/schemas/v4/handshake.status.schema.json",
  "title": "V4 handshake.status",
  "type": "object",
  "required": [
    "done",
    "requestId"
  ],
  "properties": {
    "done": {
      "description": "握手是否已完成",
      "type": "boolean"
    },
    "error": {
      "description": "失败原因码；成功时为空",
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "status": {
      "description": "完成后的配对状态；未完成时为空",
      "anyOf": [
        {
          "$ref": "#/definitions/PairingState"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "PairingState": {
      "description": "配对状态。\n\n`Active` 不是一次确认永久有效 —— 需要周期性**双向对账**维持 （`GET /api/v4/sync-status`）。任一方说\"不认\"，本机即进入 `Revoking`。",
      "oneOf": [
        {
          "description": "未配对",
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "已发起，等对端确认",
          "type": "string",
          "enum": [
            "pending"
          ]
        },
        {
          "description": "已配对且双向确认有效",
          "type": "string",
          "enum": [
            "active"
          ]
        },
        {
          "description": "任一方发起解除，等待对端 ack",
          "type": "string",
          "enum": [
            "revoking"
          ]
        },
        {
          "description": "已解除（终态）",
          "type": "string",
          "enum": [
            "revoked"
          ]
        }
      ]
    }
  }
}
