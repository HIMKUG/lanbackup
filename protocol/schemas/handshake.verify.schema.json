{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsend-v3/schemas/handshake.verify.schema.json",
  "title": "POST /api/v3/handshake/verify 请求与响应（首次配对路径 A / 重连路径 B）",
  "description": "验 HMAC（连接码隐式验证）→ 响应 approved。verify 响应绝不包含任何密钥（方案.txt §3.4 前提）。防重放靠构造（幂等）：每次握手 nonce 都是新的，重放自然失败。",
  "request": {
    "type": "object",
    "required": ["deviceId", "clientEphPub", "clientNonce", "hmac"],
    "properties": {
      "deviceId": { "type": "string", "format": "uuid" },
      "clientEphPub": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{80,}$",
        "description": "客户端临时 P-256 公钥，SEC1 未压缩 base64url"
      },
      "clientPublicKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{80,}$",
        "description": "v5：客户端本机 ECDSA P-256 签名公钥，SEC1 未压缩 base64url（服务端存储为信任锚 peerPublicKey）"
      },
      "clientNonce": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "32B 随机 hex" },
      "challengeToken": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "description": "重连（路径 B）时回传的 JWT；首次配对（路径 A）不携带"
      },
      "hmac": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{40,}$",
        "description": "HMAC-SHA256(pairing_secret, serverNonce || clientNonce) base64url"
      }
    },
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "required": ["status", "deviceId", "publicKey", "signature", "capabilities"],
    "properties": {
      "status": { "type": "string", "const": "approved" },
      "deviceId": { "type": "string", "format": "uuid" },
      "publicKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{80,}$",
        "description": "v5：本机 ECDSA P-256 签名公钥，SEC1 未压缩 base64url（客户端存储为信任锚 peerPublicKey）"
      },
      "signature": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{80,}$",
        "description": "v5：ECDSA 签名，内容 = \"localsend-v3/pair\" || respDeviceId || clientDeviceId || clientNonce || serverNonce（客户端验签防 MITM）"
      },
      "capabilities": {
        "type": "object",
        "required": ["maxChunkSize", "supportedEncryption", "supportsResume"],
        "properties": {
          "maxChunkSize": { "type": "integer", "minimum": 1 },
          "supportedEncryption": { "type": "array", "items": { "type": "string", "enum": ["aes-256-gcm"] }, "minItems": 1 },
          "supportsResume": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
