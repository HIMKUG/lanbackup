{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanbackup.local/schemas/prepare-upload.response.schema.json",
  "title": "Prepare-upload 响应",
  "description": "POST /api/localsend/v2/prepare-upload 响应。files 为 fileId → token（字符串）映射，只含接收端接受的文件。",
  "type": "object",
  "required": ["sessionId", "files"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "chunkDiff": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fileComplete", "missingChunks", "matchedChunks", "mismatchedChunks"],
        "properties": {
          "fileComplete": { "type": "boolean" },
          "missingChunks": { "type": "array", "items": { "type": "integer" } },
          "matchedChunks": { "type": "array", "items": { "type": "integer" } },
          "mismatchedChunks": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "ecdhPubKey": { "type": "string" }
  },
  "additionalProperties": true
}
