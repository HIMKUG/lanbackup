{
  "name": "lanbackup-core",
  "version": "0.1.0",
  "private": true,
  "description": "局域网备份工具核心（Rust crate，桌面端与手机端共用）",
  "scripts": {
    "build": "cargo build",
    "build:release": "cargo build --release",
    "check": "cargo check --all-targets",
    "test": "cargo test",
    "clippy": "cargo clippy --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "schema": "cargo build --features gen-schema",
    "schema:check": "cargo run --bin gen-schema -- --check"
  },
  "keywords": ["lanbackup", "rust", "core"],
  "license": "MIT"
}
